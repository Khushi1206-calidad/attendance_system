# PostgreSQL used by this deployment. Use an isolated local/test database while developing.
ATTENDANCE_DATABASE_URL=postgresql://attendance:change-me@localhost:5432/attendance_test

# Stable logical identity. Do not use an IP address that might change.
ATTENDANCE_SOURCE_KEY=main-office-device
ATTENDANCE_SOURCE_NAME=Main office attendance device
ATTENDANCE_DEVICE_IP=10.0.0.2
ATTENDANCE_DEVICE_PORT=4370
ATTENDANCE_DEVICE_PASSWORD=0
ATTENDANCE_DEVICE_TIMEOUT_SECONDS=10
ATTENDANCE_DEVICE_TIMEZONE=Asia/Kolkata

# Timestamp policy. These reproduce the existing report's validation window and remain configurable.
ATTENDANCE_MIN_VALID_TIMESTAMP=2015-01-01T00:00:00
ATTENDANCE_MAX_FUTURE_SECONDS=86400

ATTENDANCE_BATCH_SIZE=1000
# Each sync re-checks punches up to this long before the newest stored punch;
# older device records are skipped (duplicate protection still applies).
ATTENDANCE_SYNC_LOOKBACK_SECONDS=86400
ATTENDANCE_MAX_ATTEMPTS=3
ATTENDANCE_RETRY_INITIAL_SECONDS=1
ATTENDANCE_RETRY_MAX_SECONDS=10
ATTENDANCE_LOG_LEVEL=INFO
ATTENDANCE_LOG_FORMAT=json

# Read-only Django Ninja REST API (`attendance-service web`). Scheduling and
# synchronization remain separate commands.
ATTENDANCE_API_HOST=127.0.0.1
ATTENDANCE_API_PORT=8000
# Host names the API answers to (comma-separated).
ATTENDANCE_API_ALLOWED_HOSTS=127.0.0.1,localhost
# Optional; a random per-process key is used when unset (no sessions are used).
# ATTENDANCE_DJANGO_SECRET_KEY=
ATTENDANCE_API_DB_POOL_MIN_SIZE=1
ATTENDANCE_API_DB_POOL_MAX_SIZE=5
# Warn above this span; never alter the calculated result (18 hours here).
ATTENDANCE_UNREASONABLE_SPAN_SECONDS=64800
# Working day D runs from D at this time to D+1 at this time (HH:MM, device timezone).
# After-midnight night-shift punches therefore count toward the previous day.
# 00:00 restores plain calendar days.
ATTENDANCE_WORKING_DAY_CUTOFF=06:00
